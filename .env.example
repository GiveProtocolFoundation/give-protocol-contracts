# ========== DEPLOYER ==========
PRIVATE_KEY=your_private_key_here

# ========== TREASURY ADDRESSES ==========
BASE_TREASURY_ADDRESS=0x...
OPTIMISM_TREASURY_ADDRESS=0x...
MOONBEAM_TREASURY_ADDRESS=0x...
ETHEREUM_TREASURY_ADDRESS=0x...
ARBITRUM_TREASURY_ADDRESS=0x...
POLYGON_TREASURY_ADDRESS=0x...
AVALANCHE_TREASURY_ADDRESS=0x...

# ========== BASE ==========
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org
BASESCAN_API_KEY=your_basescan_api_key

# ========== OPTIMISM ==========
OPTIMISM_SEPOLIA_RPC_URL=https://sepolia.optimism.io
OPTIMISM_RPC_URL=https://mainnet.optimism.io
OPTIMISM_ETHERSCAN_API_KEY=your_optimism_etherscan_api_key

# ========== MOONBEAM ==========
MOONBASE_RPC_URL=https://rpc.api.moonbase.moonbeam.network
MOONBEAM_RPC_URL=https://rpc.api.moonbeam.network
MOONBEAM_API_KEY=your_onfinality_api_key
MOONSCAN_API_KEY=your_moonscan_api_key

# ========== ETHEREUM / ARBITRUM / POLYGON / AVALANCHE ==========
# ETHERSCAN_API_KEY is the Etherscan V2 unified key — one key verifies on
# Etherscan, Arbiscan, Polygonscan, and Snowtrace via the chainid param.
ETHEREUM_RPC_URL=https://eth.drpc.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
ETHERSCAN_API_KEY=your_etherscan_v2_api_key

# ========== GAS REPORTING ==========
REPORT_GAS=true
COINMARKETCAP_API_KEY=
